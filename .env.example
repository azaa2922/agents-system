# ===== Заавал =====
# Claude API түлхүүр — https://platform.claude.com/ дээрээс авна
ANTHROPIC_API_KEY=sk-ant-...

# ===== Search Agent-д заавал =====
# Tavily вэб хайлтын API түлхүүр — https://tavily.com/ дээрээс авна
TAVILY_API_KEY=tvly-...

# ===== Сонголтоор =====
# Code Agent: үүсгэсэн төслөө GitHub руу push хийх бол
GITHUB_TOKEN=
GIT_REMOTE_URL=

# DB Agent: бодит өгөгдлийн санд холбогдох бол (одоогоор schema файл л үүсгэнэ)
DB_CONNECTION_STRING=

# Agentic loop: session тракинг Firebase RTDB-д хадгалах бол (байхгүй бол in-memory горимд ажиллана)
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Agentic loop-ийн модель (default: claude-opus-4-8)
AGENTIC_LOOP_MODEL=
