# ===== Заавал =====
# Claude API түлхүүр — https://platform.claude.com/ дээрээс авна
ANTHROPIC_API_KEY=sk-ant-...

# ===== Search Agent-д заавал =====
# Tavily вэб хайлтын API түлхүүр — https://tavily.com/ дээрээс авна
TAVILY_API_KEY=tvly-...

# ===== Сонголтоор =====
# Code Agent: үүсгэсэн төслөө GitHub руу push хийх бол
GITHUB_TOKEN=
GIT_REMOTE_URL=

# DB Agent: бодит өгөгдлийн санд холбогдох бол (одоогоор schema файл л үүсгэнэ)
DB_CONNECTION_STRING=

# ===== Санах ой (Firebase Realtime Database) — сонголтоор =====
# Тохируулбал бүх агент явцаа /agents, /agent_history дор бүртгэж, context
# хуримтлуулна. Тохируулаагүй бол агентууд санах ойгүйгээр хэвийн ажиллана.
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
