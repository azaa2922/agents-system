{
  "name": "agents-system",
  "version": "1.0.0",
  "description": "Multi-agent AI system powered by Google Gemini — 6 independent CLI agents",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "search": "node src/search-agent/index.js",
    "file": "node src/file-agent/index.js",
    "code": "node src/code-agent/index.js",
    "data": "node src/data-agent/index.js",
    "write": "node src/writer-agent/index.js",
    "db": "node src/db-agent/index.js",
    "orchestrate": "node src/orchestrator/index.js",
